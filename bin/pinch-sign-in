#!/usr/bin/env node
// pinch-sign-in — mint a one-time magic-link sign-in URL for the owner.
//
// Usage:
//   pinch-sign-in            # prints { url, expiresAt } JSON
//
// Invoked by the magic-link-login skill when the owner texts an intent to sign
// in / open their library on the web. Authenticates with the account's cached
// full token and calls the backend `POST /api/pinch/magic-link` (spec §6 /
// Chunk 6), which mints a one-time, short-TTL link scoped to this account and
// returns `{ url, expiresAt }`. The agent then texts the `url` to the owner.
//
// stdout: a JSON object the skill reads to compose the warm reply. The `url`
// embeds a one-time login token meant to be handed to the owner — printing it
// here is the intended delivery path, not a leak. The account full token and
// PLOW_AGENT_TOKEN are NEVER printed. Reads PINCH_BACKEND_URL from the env.
//
// Exit codes (match the other helpers): 2 missing env, 4 backend unreachable,
// 5 auth (401/403), 1 everything else.
'use strict';
process.stdout.on('error', (e) => { if (e && e.code === 'EPIPE') process.exit(0); throw e; });
const { resolveFullToken } = require('./lib/pinch-token');

const BASE = (process.env.PINCH_BACKEND_URL || '').replace(/\/+$/, '');
const TOKEN = resolveFullToken();

function die(msg, code = 1) { process.stderr.write(`pinch-sign-in: ${msg}\n`); process.exit(code); }
if (!BASE) die('PINCH_BACKEND_URL is not set', 2);
if (!TOKEN) die('no API token available (no cached account token and PINCH_API_TOKEN is not set)', 2);

(async () => {
  let res;
  try {
    res = await fetch(`${BASE}/api/pinch/magic-link`, {
      method: 'POST',
      headers: { Authorization: `Bearer ${TOKEN}`, 'Content-Type': 'application/json' },
      body: '{}',
    });
  } catch (e) {
    die(`backend unreachable: ${e.message} — no sign-in link was minted`, 4);
  }
  const text = await res.text();
  if (!res.ok) {
    die(`backend returned ${res.status}: ${text} — no sign-in link was minted`, res.status === 401 || res.status === 403 ? 5 : 1);
  }
  let data;
  try { data = JSON.parse(text); } catch { die('unexpected (non-JSON) response from backend', 1); }
  const url = typeof data.url === 'string' && data.url ? data.url : null;
  if (!url) die('backend returned no sign-in url', 1);
  const expiresAt = typeof data.expiresAt === 'string' && data.expiresAt ? data.expiresAt : null;
  process.stdout.write(JSON.stringify({ url, expiresAt }, null, 2) + '\n');
})();
