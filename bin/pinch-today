#!/usr/bin/env node
// pinch-today — what's planned for the household's REAL "today"
// (GET /api/pinch/plan/today).
//
// Usage:
//   pinch-today            # today's slots + the resolved local date
//   pinch-today --json     # raw { accountPublicId, date, meals }
//
// WHY this exists (and why it is the helper to use for "what's for dinner" /
// "what's planned today"): the backend resolves "today" in the HOUSEHOLD's
// timezone (not UTC). The agent's injected system-prompt "Current date" renders
// in UTC — in the evening Pacific it is already TOMORROW — so self-picking the
// day off that date reads the wrong slot (often an empty one → "nothing
// planned"). This helper asks the backend, which owns the local day boundary.
//
// The FIRST stdout line is `today: <YYYY-MM-DD> (<tz>)` — the backend's RESOLVED
// LOCAL date. That is the agent's correct "today" anchor: derive "this week" and
// any relative day ("tomorrow", "Wednesday") from THIS date, never from the raw
// injected UTC date. Then one line per planned slot:
//   "<slot>: <title>"            a recipe entry (title already resolved)
//   "<slot>: note: <text>"       a free-text NOTE entry (a real planned item)
// A slot can hold several entries, so you may see several lines for one slot;
// they are all real. An empty day prints just the `today:` line (and notes it on
// stderr).
//
// Timezone is resolved BY THE BACKEND. We deliberately pass NO `?tz=`, so the
// backend uses the owner's STORED account timezone (set via pinch-set-timezone),
// falling back to its own env default (America/Los_Angeles) when none is stored.
// Passing an explicit `?tz=` here would OVERRIDE a stored zone and defeat the
// per-user setting, so we don't. The Pacific default is preserved by the
// backend's own fallback. Change the owner's zone with the set-timezone skill.
//
// Reads PINCH_BACKEND_URL and PINCH_API_TOKEN from the environment.
'use strict';
process.stdout.on('error', (e) => { if (e && e.code === 'EPIPE') process.exit(0); throw e; });
const { dieFor, requireEnv, api, parse } = require('./lib/pinch-http');
const die = dieFor('pinch-today');
requireEnv(die);

const args = process.argv.slice(2);
const asJson = args.includes('--json');

(async () => {
  // No `?tz=` on purpose — the backend resolves "today" from the stored account
  // timezone (or its Pacific default). See the header note.
  const { text } = await api(die, 'GET', '/api/pinch/plan/today');
  const data = parse(die, text);
  const meals = Array.isArray(data.meals) ? data.meals : [];

  if (asJson) {
    process.stdout.write(JSON.stringify(data, null, 2) + '\n');
    return;
  }

  // The backend-resolved LOCAL date (the day the household is actually living),
  // in the owner's stored timezone — the agent's "today" anchor. Always printed,
  // even on an empty day.
  process.stdout.write(`today: ${data.date}\n`);

  if (meals.length === 0) {
    process.stderr.write(`Nothing planned for ${data.date}\n`);
    return;
  }

  process.stderr.write(`${meals.length} planned for ${data.date}\n`);
  for (const m of meals) {
    // A NOTE entry (no recipe) surfaces its text; a recipe entry shows its title.
    const label = m.note ? `note: ${m.note}` : (m.title || `(recipe ${m.recipeId})`);
    process.stdout.write(`${m.slot}: ${label}\n`);
  }
})();
