#!/usr/bin/env node
// pinch-add-item — add ONE manual (hand-added) item to a grocery list
// (POST /api/pinch/lists/:id/items). The server parses + consolidates the line
// (origin='manual'); an optional --aisle overrides the aisle guess.
//
// Usage:
//   pinch-add-item "<text>"                       # defaults to the "This Week" (default) list
//   pinch-add-item "<text>" --list <listId>       # a specific list
//   pinch-add-item "<text>" --aisle "Produce"
//
// The list defaults to the `default` ("This Week") sentinel — the owner's "my
// list" — so "add paper towels" just works (the backend auto-materializes the
// default list on add). Reads PINCH_BACKEND_URL and PINCH_API_TOKEN.
'use strict';
process.stdout.on('error', (e) => { if (e && e.code === 'EPIPE') process.exit(0); throw e; });
const { dieFor, requireEnv, api, parse } = require('./lib/pinch-http');
const die = dieFor('pinch-add-item');
requireEnv(die);

const args = process.argv.slice(2);
const listIdx = args.indexOf('--list');
const listId = listIdx !== -1 ? args[listIdx + 1] : 'default';
if (!listId) die('--list needs a value', 2);
const aisleIdx = args.indexOf('--aisle');
const aisle = aisleIdx !== -1 ? args[aisleIdx + 1] : null;
// Positionals (skipping `--list <v>` / `--aisle <v>`) form the item text.
const textTokens = [];
for (let i = 0; i < args.length; i++) {
  if (args[i] === '--list' || args[i] === '--aisle') { i++; continue; } // skip the flag + its value
  textTokens.push(args[i]);
}
const text = textTokens.join(' ').trim();
if (!text) die('no item text — usage: pinch-add-item "<text>" [--list <listId>] [--aisle "<aisle>"]', 2);

(async () => {
  const body = aisle ? { text, aisle } : { text };
  const { res, text: resText } = await api(
    die,
    'POST',
    `/api/pinch/lists/${encodeURIComponent(listId)}/items`,
    { body, allow404: true },
  );
  if (res.status === 404) die(`no list with id "${listId}" (create it with pinch-lists --create)`, 1);
  const { items } = parse(die, resText);
  process.stderr.write(`Added "${text}" to ${listId} — ${items.length} item${items.length === 1 ? '' : 's'} now on the list\n`);
  for (const it of items) process.stdout.write(`${it.checked ? '[x]' : '[ ]'} ${it.text}\n`);
})();
