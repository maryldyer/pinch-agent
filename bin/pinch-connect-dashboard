#!/usr/bin/env node
// pinch-connect-dashboard — produce the account's READ-WRITE dashboard embed link.
//
// Usage:
//   pinch-connect-dashboard         # prints { embedUrl, token, source } JSON
//
// Invoked by the "connect dashboard" skill when the owner texts an intent to
// pair their dashboard. It POSTs the backend connect-dashboard endpoint with the
// account full token; the backend mints a dedicated FULL (read-write) token and
// returns the ready-to-paste link that carries it. `embedUrl` is that link
// (backend /embed?token=<full>) — paste it straight into the Hive wall and the
// wall can add groceries / edit lists, not just view. On any endpoint hiccup this
// exits non-zero (it never hands back a stale read-only link).
//
// stdout: a JSON object the skill reads to compose the warm reply. The `token`
// value is the OWNER'S embed token, meant to be handed to them (printing it here
// is the intended delivery path, not a leak). PLOW_AGENT_TOKEN is NEVER printed.
// Exit 0 on success, non-zero if no link is available.
'use strict';
const { connectDashboard } = require('./lib/onboarding');

const log = (m) => process.stderr.write(`pinch-connect-dashboard: ${m}\n`);

(async () => {
  try {
    const r = await connectDashboard({ logger: log });
    process.stdout.write(JSON.stringify({ embedUrl: r.embedUrl, token: r.token, source: r.source }, null, 2) + '\n');
    process.exit(0);
  } catch (e) {
    log(`WARN: ${e.message}`);
    process.exit(1);
  }
})();
