#!/usr/bin/env node
// pinch-check — check (or uncheck) one item on a grocery list while shopping
// (PATCH /api/pinch/lists/:id/items/:itemId).
//
// Usage:
//   pinch-check <listId> <itemId>              # mark as got (checked = true)
//   pinch-check <listId> <itemId> --uncheck    # un-check it
//
// Item ids come from `pinch-list-items <listId> --json`. Reads PINCH_BACKEND_URL
// and PINCH_API_TOKEN from the environment.
'use strict';
process.stdout.on('error', (e) => { if (e && e.code === 'EPIPE') process.exit(0); throw e; });
const { dieFor, requireEnv, api, parse } = require('./lib/pinch-http');
const die = dieFor('pinch-check');
requireEnv(die);

const args = process.argv.slice(2);
const listId = args[0];
const itemId = args[1];
const checked = !args.includes('--uncheck');
if (!listId || !itemId) die('usage: pinch-check <listId> <itemId> [--uncheck]', 2);

(async () => {
  const { res, text } = await api(
    die,
    'PATCH',
    `/api/pinch/lists/${encodeURIComponent(listId)}/items/${encodeURIComponent(itemId)}`,
    { body: { checked }, allow404: true },
  );
  if (res.status === 404) die(`no such list/item (${listId}/${itemId})`, 1);
  const { items } = parse(die, text);
  const it = items.find((x) => x.id === itemId);
  process.stderr.write(`${checked ? 'Checked off' : 'Un-checked'} ${it ? `"${it.text}"` : itemId}\n`);
})();
